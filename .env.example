# Database
DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# LLM — AWS Bedrock (production default for F-01)
# Local dev: use AWS SSO profile, leave access keys empty
# Render prod: create IAM user with bedrock:InvokeModel, paste access keys here
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# LLM — OpenRouter (experimentation provider)
# Get an API key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Deliberately left unset. ":free" slugs are retired without notice, so the working slug is a
# maintained value with the evidence next to it in application-openrouter.properties — and an
# override here silently wins over it. This line shipped `meta-llama/llama-3.3-70b-instruct:free`
# until 2026-09-11, ten weeks after that slug started returning 404; production is unaffected only
# because Render never set the variable. Set it to pin a slug for one machine, not as a default.
# OPENROUTER_MODEL=

# Direct provider keys (optional — only if calling Anthropic/OpenAI without Bedrock/OpenRouter)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Context7 MCP (library docs lookup for Claude Code)
CONTEXT7_API_KEY=

# CLI tool credentials
RENDER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
