#!/bin/sh
# Middle local layer: scoped to what is actually staged.
#
# Carries the checks too slow for the per-edit hook -- chiefly the backend suite at ~15 s, which is a
# commit-time cost, not a keystroke-time one. Scoped by staged path so a docs-only commit stays
# instant and a Java-only commit does not pay for the frontend.
#
# What this layer catches that the per-edit hook cannot: edits that never went through Write|Edit at
# all -- a manual change in the editor, a `git checkout -p`, a merge resolution, anything the agent
# did not make.

. "$(dirname "$0")/common.sh"

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$STAGED" ] || exit 0

FRONTEND_SOURCES=$(echo "$STAGED" | grep -E '^frontend/src/.*\.(ts|html|scss)$' || true)
BACKEND_SOURCES=$(echo "$STAGED" | grep -E '^backend/(src/.*\.java|pom\.xml)$' || true)
# packages/* has no deploy path -- nothing builds it -- so this arm exists purely because an untested
# tool is worse than no tool: the code reviewer's whole job is to notice defects, and one that is
# itself broken reports a clean review; the ai-toolkit installer's job is to write into *other*
# people's repositories. Matches the manifests too, since a dependency bump is the change most
# likely to break either without touching a line of src.
#
# The pattern was widened when ai-toolkit landed, and the old one is worth naming: it matched only
# `src/*.ts`, `scripts/*.mjs`, `package.json` and `tsconfig.json`, so `install.js`, `bin/*.js`,
# `lib/*.js`, `pack.yaml` and every `skills/**` file matched nothing at all -- the file that edits
# other repositories' CLAUDE.md was the least gated thing in the tree. Keep this list in step with
# what the packages actually ship.
PACKAGE_SOURCES=$(echo "$STAGED" | grep -E '^packages/[^/]+/(src/.*\.(ts|js)|lib/.*\.js|bin/.*\.js|test/.*\.(ts|js)|scripts/.*\.mjs|skills/.*|rules/.*|install\.js|uninstall\.js|package\.json|tsconfig\.json|pack\.yaml|\.npmrc)$' || true)

# Which packages, not just "some package". The arm this replaces ran the code-reviewer checks for
# any match, so staging a file in a different package printed ok over a package nothing had checked.
CHANGED_PACKAGES=$(echo "$PACKAGE_SOURCES" | sed -n 's|^packages/\([^/]*\)/.*|\1|p' | sort -u)

TERRAFORM_SOURCES=$(echo "$STAGED" | grep -E '^terraform/.*\.(tf|mjs)$' || true)

[ -n "$FRONTEND_SOURCES" ] || [ -n "$BACKEND_SOURCES" ] || [ -n "$PACKAGE_SOURCES" ] ||
  [ -n "$TERRAFORM_SOURCES" ] || exit 0

echo "pre-commit:"

if [ -n "$FRONTEND_SOURCES" ]; then
  require_node
  step "prettier --check on staged frontend sources"
  # --check, not --write: a hook that rewrites staged files commits something the author never saw.
  # The per-edit hook already formats on the way in, so reaching here means the file bypassed it.
  if ! (cd frontend && echo "$FRONTEND_SOURCES" | sed 's|^frontend/||' | xargs npx prettier --check); then
    fail "staged frontend files are not formatted. Run: cd frontend && npx prettier --write \"src/**/*.{ts,html,scss}\""
  fi

  step "frontend suite (51 tests, ~6 s)"
  run_frontend_tests
fi

if [ -n "$BACKEND_SOURCES" ]; then
  step "backend suite (249 tests, ~15 s; live-llm excluded)"
  run_backend_tests
fi

for pkg in $CHANGED_PACKAGES; do
  run_package_checks "$pkg"
done

if [ -n "$TERRAFORM_SOURCES" ]; then
  step "terraform static checks (<1 s; terraform itself is not installed)"
  run_terraform_checks
fi

echo "  ok"
